# ─────────────────────────────────────────────────────────────
# Cloudflare Worker Usage Monitor — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy file này thành `.env` và điền giá trị thực:
#   cp .env.example .env
#
# KHÔNG bao giờ commit file `.env` lên Git.
# `.env` đã được thêm vào `.gitignore`.
# ─────────────────────────────────────────────────────────────

# --- Cloudflare (Account 1) ---
# Email đăng nhập tài khoản Cloudflare
API_EMAIL=your_cloudflare_email@example.com

# Global API Key — lấy tại https://dash.cloudflare.com/profile/api-tokens
# (Khuyến nghị: dùng API Token scoped thay vì Global Key nếu có thể)
API_KEY=your_cloudflare_global_api_key_here

# Account ID — lấy từ URL dashboard Cloudflare (dash.cloudflare.com/<ACCOUNT_ID>/...)
ACCOUNT_ID=your_cloudflare_account_id_here

# --- Cloudflare (Account 2 — chỉ cần nếu dùng multi-account) ---
# API_EMAIL2=second_cloudflare_email@example.com
# API_KEY2=second_cloudflare_global_api_key
# ACCOUNT_ID2=second_cloudflare_account_id

# --- Telegram Bot ---
# Token của bot — tạo mới qua @BotFather trên Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID — gửi cho bot 1 tin nhắn rồi gọi:
#   https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
# Lấy giá trị trường `message.chat.id`
CHAT_ID=123456789

# --- Tuỳ chọn ---
# Giới hạn quota/ngày của free tier (mặc định: 100000)
# DAILY_LIMIT=100000
